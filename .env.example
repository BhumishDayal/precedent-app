# Every key is optional. With none set, Dial, Keewano, Darwin and Sparta run in dry-run and nothing is sent.
# Leave a number unset rather than blank to get its default.

# Dial: texts and calls
DIAL_API_KEY=
DIAL_API_BASE=https://api.getdial.ai/api/v1
DIAL_FROM_NUMBER_ID=
DIAL_TEXT_FROM_NUMBER=
DIAL_INBOUND=poll
ALERT_CHANNEL=call
ONCALL_PHONE=
ONCALL_NAME=On-call engineer
TECH_INBOX_NUMBER=
TECH_NAME=Technician

# Keewano: event store and in-database scoring
KEEWANO_PAT=
KEEWANO_INGEST_KEY=
KEEWANO_PROJECT_ID=

# Darwin: agent search for parts and warranty returns
DARWIN_API_KEY=

# Sparta: rehearse the ticket in a sandbox world before the real one
SPARTA_ZENDESK_URL=
SPARTA_API_KEY=
SPARTA_WORLD_ID=
SPARTA_ADMIN_URL=http://127.0.0.1:4242
SPARTA_ADMIN_TOKEN=
SPARTA_INJECT_FAULT=1

# Where alerts are posted. Slack buttons are rejected unless SLACK_SIGNING_SECRET is set.
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
OUTBOUND_WEBHOOK_URL=

# URLs. PUBLIC_URL is only needed for Dial webhooks (DIAL_INBOUND=webhook).
APP_URL=http://localhost:8000
PUBLIC_URL=

# /v1 API keys, comma separated. Empty means the /v1 API is open: set this before exposing the server.
PRECEDENT_API_KEYS=
# Used by the collector and fleet replay when they post to /v1.
PRECEDENT_URL=http://127.0.0.1:8000
PRECEDENT_KEY=

# Decision thresholds
HORIZON_DAYS=30
MIN_N=15
MIN_RATE=0.25
SWAPLIST_MIN_N=10
SWAPLIST_MIN_RATE=0.10
ACK_SECONDS=300
ESCALATE_SECONDS=60

# Fleet replay: serials besides the demo drive that may page a real phone, comma separated.
PAGE_SERIALS=
